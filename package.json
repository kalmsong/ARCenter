    "lucide-react": "^0.417.0",
    "marked": "^13.0.2",
    "motion": "^12.40.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
