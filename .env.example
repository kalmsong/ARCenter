# Browser-safe values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback only; do not set when SUPABASE_SECRET_KEY is used.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# External FastAPI
AIRTECT_API_BASE_URL=https://api.airtect.kr
# Maximum wait for one API-first evidence request.
AIRTECT_EVIDENCE_TIMEOUT_MS=8000
# true/omitted: 4 law URLs, 2 files, compact API context.
# false: full operating limits.
ARCENTER_TEST_MODE=true
# Development only. Never enable on a public production server.
ALLOW_INSECURE_AIRTECT=false

PORT=3000
NODE_ENV=development
